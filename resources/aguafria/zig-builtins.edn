   :param-count 1,
   :signature "@alignCast(ptr: anytype) anytype",
   :tag "align_cast",
   :zig-name "@alignCast"}
  {:allows-lvalue? false,
   :documentation
   "This function returns the number of bytes that this type should be aligned to for the current target to match the C ABI. When the child type of a pointer has this alignment, the alignment can be omitted from the type.\n\n```zig\nconst assert = @import(\"std\").debug.assert;\ncomptime {\n    assert(*u32 == *align(@alignOf(u32)) u32);\n}\n```\nThe result is a target-specific compile time constant. It is guaranteed to be less than or equal to [@sizeOf(T)](https://ziglang.org/documentation/0.16.0/#sizeOf).",
   :documentation-format :markdown,
   :documentation-source :zls-langref,
   :eval-to-error :never,
   :illegal-outside-function? false,
   :name "alignOf",
   :param-count 1,
