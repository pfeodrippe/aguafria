     :param-count 3,
     :source "std/os/uefi/tables/boot_services.zig",
     :zig-name
     "@import(\"std\").os.uefi.tables.BootServices.allocatePool",
     :documentation
     "Allocates a memory region of size bytes from memory of type pool_type\nand returns the allocated memory. Allocates pages from .conventional_memory\nas needed to grow the requested pool type.",
