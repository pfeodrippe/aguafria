     :param-count nil,
     :source "std/crypto/kangarootwelve.zig",
     :zig-name "@import(\"std\").crypto.hash.sha3.KT128",
     :documentation
     "KangarooTwelve is a fast, secure cryptographic hash function that uses tree-hashing\non top of TurboSHAKE. It is built on the Keccak permutation, the same primitive\nunderlying SHA-3, which has undergone over 15 years of intensive cryptanalysis\nsince the SHA-3 competition (2008-2012) and remains secure.\n\nK12 uses Keccak-p[1600,12] with 12 rounds (half of SHA-3's 24 rounds), providing\n128-bit security strength equivalent to AES-128 and SHAKE128. While this offers\nless conservative margin than SHA-3, current cryptanalysis reaches only 6 rounds,\nleaving a substantial security margin. This deliberate trade-off delivers\nsignificantly better performance while maintaining strong practical security.\n\nStandardized as RFC 9861 after 8 years of public scrutiny. Supports arbitrary-length\noutput and optional customization strings for domain separation.",
     :clojure-name "KT128",
     :container false,
     :alias-depth 1}
    {:category :type,
     :zig-version "0.16.0",
     :symbol aguafria.std.crypto.hash.sha3/KT256,
     :name "KT256",
