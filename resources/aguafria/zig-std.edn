     "pub fn relativePosix(allocator: Allocator, cwd: []const u8, from: []const u8, to: []const u8) Allocator.Error![]u8",
     :param-count 4,
     :source "std/fs/path.zig",
     :zig-name "@import(\"std\").Io.Dir.path.relativePosix",
     :documentation
     "Returns the non-absolute path from from to to according to Windows rules.\n\nOther than memory allocation, this is a pure function; the result solely\ndepends on the input parameters.\n\nIf from and to each resolve to the same path (after calling resolve\non each), a zero-length string is returned.",
     :clojure-name "relativePosix",
