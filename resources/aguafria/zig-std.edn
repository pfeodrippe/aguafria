    {:category :function,
     :zig-version "0.16.0",
     :symbol aguafria.std.debug.Dwarf.Unwind/initEhFrameHdr,
     :name "initEhFrameHdr",
     :signature
     "pub fn initEhFrameHdr(header: EhFrameHeader, section_vaddr: u64, section_bytes_ptr: [*]const u8) Unwind",
     :param-count 3,
     :source "std/debug/Dwarf/Unwind.zig",
     :zig-name "@import(\"std\").debug.Dwarf.Unwind.initEhFrameHdr",
     :documentation
     "Initialize with unwind information from a header loaded from an .eh_frame_hdr section, and a\npointer to the contents of the .eh_frame section.\n\n.eh_frame_hdr may embed a binary search table of FDEs. If it does, we will use that table for\nPC lookups rather than spending time constructing our own search table.",
     :clojure-name "initEhFrameHdr",
     :container false,
     :alias-depth 0}
    {:category :function,
     :zig-version "0.16.0",
     :symbol aguafria.std.debug.Dwarf.Unwind/initSection,
     :name "initSection",
     :signature
     "pub fn initSection(section: Section, section_vaddr: u64, section_bytes: []const u8) Unwind",
     :param-count 3,
     :source "std/debug/Dwarf/Unwind.zig",
     :zig-name "@import(\"std\").debug.Dwarf.Unwind.initSection",
     :documentation
     "Initialize with unwind information from the contents of a .debug_frame or .eh_frame section.\n\nIf the .eh_frame_hdr section is available, consider instead using initEhFrameHdr, which\nallows the implementation to use a search table embedded in that section if it is available.",
     :clojure-name "initSection",
     :container false,
     :alias-depth 0}
    {:category :function,
     :zig-version "0.16.0",
     :symbol aguafria.std.debug.Dwarf.Unwind/lookupPc,
     :name "lookupPc",
     :signature
     "pub fn lookupPc(unwind: *const Unwind, pc: u64, addr_size_bytes: u8, endian: Endian) !?u64",
     :param-count 4,
     :source "std/debug/Dwarf/Unwind.zig",
     :zig-name "@import(\"std\").debug.Dwarf.Unwind.lookupPc",
     :documentation
     "Given a program counter value, returns the offset of the corresponding FDE, or null if no\nmatching FDE was found. The returned offset can be passed to getFde to load the data\nassociated with the FDE.\n\nBefore calling this function, prepare must return successfully at least once, to ensure that\nunwind.lookup is populated.\n\nThe return value may be a false positive. After loading the FDE with loadFde, the caller must\nvalidate that pc is indeed in its range -- if it is not, then no FDE matches pc.",
     :clojure-name "lookupPc",
     :container false,
     :alias-depth 0}
    {:category :function,
     :zig-version "0.16.0",
     :symbol aguafria.std.debug.Dwarf.Unwind/prepare,
     :name "prepare",
     :signature
     "pub fn prepare( unwind: *Unwind, gpa: Allocator, addr_size_bytes: u8, endian: Endian, need_lookup: bool, is_macho: bool, ) !void",
     :param-count 6,
     :source "std/debug/Dwarf/Unwind.zig",
     :zig-name "@import(\"std\").debug.Dwarf.Unwind.prepare",
     :documentation
     "Builds the CIE list and FDE lookup table if they are not already built. It is required to call\nthis function at least once before calling lookupPc or getFde. If only getFde is needed,\nthen need_lookup can be set to false to make this function more efficient.",
     :clojure-name "prepare",
     :container false,
     :alias-depth 0}],
   :name aguafria.std.debug.Dwarf.Unwind,
   :zig-path ["debug" "Dwarf" "Unwind"]}
