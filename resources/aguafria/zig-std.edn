    {:category :function,
     :zig-version "0.16.0",
     :symbol aguafria.std.zon.parse/fromSlice,
     :name "fromSlice",
     :signature
     "pub fn fromSlice( T: type, gpa: Allocator, source: [:0]const u8, diag: ?*Diagnostics, options: Options, ) error{ OutOfMemory, ParseZon }!T",
     :param-count 5,
     :source "std/zon/parse.zig",
     :zig-name "@import(\"std\").zon.parse.fromSlice",
     :documentation
     "Parses the given slice as ZON.\n\nReturns error.OutOfMemory on allocation failure, or error.ParseZon error if the ZON is\ninvalid or can not be deserialized into type T.\n\nWhen the parser returns error.ParseZon, it will also store a human readable explanation in\ndiag if non null. If diag is not null, it must be initialized to .{}.\n\nAsserts at compile time that the result type doesn't contain pointers. As such, the result\ndoesn't need to be freed.\n\nAn allocator is still required for temporary allocations made during parsing.",
     :clojure-name "fromSlice",
     :container false,
     :alias-depth 0}
