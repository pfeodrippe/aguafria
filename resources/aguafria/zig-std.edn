     :symbol aguafria.std.os.windows/hasCommonNtPrefix,
     :name "hasCommonNtPrefix",
     :signature
     "pub fn hasCommonNtPrefix(comptime T: type, path: []const T) bool",
     :param-count 2,
     :source "std/os/windows.zig",
     :zig-name "@import(\"std\").os.windows.hasCommonNtPrefix",
     :documentation
     "Returns true if the path starts with \\??\\, which is indicative of an NT path\nbut is not enough to fully distinguish between NT paths and Win32 paths, as\n\\??\\ is not actually a distinct prefix but rather the path to a special virtual\nfolder in the Object Manager.\n\nFor example, \\Device\\HarddiskVolume2 and \\DosDevices\\C: are also NT paths but\ncannot be distinguished as such by their prefix.\n\nSo, inferring whether a path is an NT path or a Win32 path is usually a mistake;\nthat information should instead be known ahead-of-time.\n\nIf T is u16, then path should be encoded as WTF-16LE.",
     :clojure-name "hasCommonNtPrefix",
     :container false,
     :alias-depth 0}
