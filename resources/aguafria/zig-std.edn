     :param-count 2,
     :source "std/Io.zig",
     :zig-name "@import(\"std\").Io.Queue.getOne",
     :documentation
     "Receives one element from the beginning of the queue, blocking if the queue is empty.",
     :clojure-name "getOne",
     :container false,
     :alias-depth 0}
    {:category :function,
