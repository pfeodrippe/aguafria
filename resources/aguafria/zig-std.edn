     :source "std/zip.zig",
     :zig-name "@import(\"std\").zip",
     :documentation
     "The .ZIP File Format Specification is found here:\nhttps://pkwaredownloads.blob.core.windows.net/pem/APPNOTE.txt\n\nNote that this file uses the abbreviation \"cd\" for \"central directory\"",
     :clojure-name "zip",
