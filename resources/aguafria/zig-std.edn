     :source "std/zig/Ast.zig",
     :zig-name "@import(\"std\").zig.Ast",
     :documentation
     "Abstract Syntax Tree for Zig source code.\nFor Zig syntax, the root node is at nodes[0] and contains the list of\nsub-nodes.\nFor Zon syntax, the root node is at nodes[0] and contains lhs as the node\nindex of the main expression.",
