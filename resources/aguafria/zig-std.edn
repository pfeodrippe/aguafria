     :container false,
     :alias-depth 0}
    {:category :function,
     :zig-version "0.16.0",
     :symbol aguafria.std.Io.Select/async,
     :name "async",
     :signature
     "pub fn async( s: *S, comptime field: Field, function: anytype, args: std.meta.ArgsTuple(@TypeOf(function)), ) void",
     :param-count 3,
     :source "std/Io.zig",
     :zig-name "@import(\"std\").Io.Select.async",
     :documentation
     "Calls function with args asynchronously. The resource spawned is\nowned by the select.\n\nfunction must have return type matching the field field of Union.\n\nfunction may be called immediately, before async returns.\n\nWhen this function returns, it is guaranteed that function has\nalready been called and completed, or it has successfully been\nassigned a unit of concurrency.\n\nAfter this is called, await or cancel must be called before the\nselect is deinitialized.\n\nThreadsafe.\n\nRelated:\n\nIo.async\n\nGroup.async",
     :clojure-name "async",
     :container false,
     :alias-depth 0}
    {:category :function,
     :zig-version "0.16.0",
     :symbol aguafria.std.Io.Select/await,
     :name "await",
     :signature "pub fn await(s: *S) Cancelable!U",
     :param-count 1,
     :source "std/Io.zig",
     :zig-name "@import(\"std\").Io.Select.await",
     :documentation
     "Blocks until another task of the select finishes.\n\nIt is legal to call async and concurrent after this.\n\nThreadsafe.",
     :clojure-name "await",
     :container false,
     :alias-depth 0}
    {:category :function,
     :zig-version "0.16.0",
     :symbol aguafria.std.Io.Select/awaitMany,
     :name "awaitMany",
     :signature
     "pub fn awaitMany(s: *S, buffer: []U, min: usize) Cancelable!usize",
     :param-count 3,
     :source "std/Io.zig",
     :zig-name "@import(\"std\").Io.Select.awaitMany",
     :documentation
     "Blocks until at least min number of results have been copied\ninto buffer.\n\nAsserts that buffer.len >= min.\n\nIt is legal to call async and concurrent after this.\n\nThreadsafe.",
     :clojure-name "awaitMany",
     :container false,
     :alias-depth 0}
    {:category :function,
     :zig-version "0.16.0",
     :symbol aguafria.std.Io.Select/cancel,
     :name "cancel",
     :signature "pub fn cancel(s: *S) ?U",
     :param-count 1,
     :source "std/Io.zig",
     :zig-name "@import(\"std\").Io.Select.cancel",
     :documentation
     "Requests cancelation on all remaining tasks owned by the select,\nthen blocks until they all finish. If the select was initialized\nwith insufficient buffer space for all remaining tasks to finish, a\ndeadlock occurs.\n\nIf any of the select tasks allocate resources, those tasks may have\ncompleted, meaning that this function must be called in a loop\nuntil null is returned in order to deallocate those resources. If\nthere is no possibility of resource leaks, cancelDiscard is\npreferable.\n\nIt is illegal to call await or awaitMany after this.\n\nIt is safe to call this multiple times, even after null is\nreturned.\n\nThreadsafe.",
     :clojure-name "cancel",
     :container false,
     :alias-depth 0}
    {:category :function,
     :zig-version "0.16.0",
     :symbol aguafria.std.Io.Select/cancelDiscard,
     :name "cancelDiscard",
     :signature "pub fn cancelDiscard(s: *S) void",
     :param-count 1,
     :source "std/Io.zig",
     :zig-name "@import(\"std\").Io.Select.cancelDiscard",
     :documentation
     "Requests cancelation on all remaining tasks owned by the select,\nthen blocks until they all finish.\n\nAll return values from outstanding tasks are discarded. This\nfunction is therefore inappropriate to call when a task can return\nan allocated resource. For that use case, see cancel.\n\nIt is illegal to call await or awaitMany after this.\n\nIt is safe to call this multiple times.\n\nThreadsafe.",
     :clojure-name "cancelDiscard",
     :container false,
     :alias-depth 0}
    {:category :function,
