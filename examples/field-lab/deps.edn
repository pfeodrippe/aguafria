{:paths ["src" "resources" "generated"]
 :deps {org.clojure/clojure {:mvn/version "1.12.0"}
        aguafria/aguafria {:local/root "../.."}
        pitoco/scripting {:local/root "scripting"}
        aguafria/examples-native {:local/root "../shared"}}
 :aliases
 {:nrepl {:extra-paths ["test"]
          :extra-deps {nrepl/nrepl {:mvn/version "1.3.1"}}
          :jvm-opts ["--enable-native-access=ALL-UNNAMED"]
          :main-opts ["-m" "nrepl.cmdline"]}
  :desktop {:extra-deps {nrepl/nrepl {:mvn/version "1.3.1"}}
            :jvm-opts ["--enable-native-access=ALL-UNNAMED"
                       "-Daguafria.async-compile=true"
                       "-XstartOnFirstThread"
                       "-Xdock:name=Pitoco Development"]
            :main-opts ["-m" "field-lab.desktop-main"]}
  :bake {:jvm-opts ["--enable-native-access=ALL-UNNAMED"]
         :main-opts ["-m" "field-lab.job"]}
  :fem {:jvm-opts ["--enable-native-access=ALL-UNNAMED"]
        :main-opts ["-m" "field-lab.fem-job"]}
  :fem-dynamics {:jvm-opts ["--enable-native-access=ALL-UNNAMED"]
                 :main-opts ["-m" "field-lab.nonlinear-job"]}
  :impact-study {:jvm-opts ["--enable-native-access=ALL-UNNAMED"]
                 :main-opts ["-m" "field-lab.impact-study"]}
  :build {:jvm-opts ["--enable-native-access=ALL-UNNAMED"]
          :main-opts ["-m" "field-lab.build"]}
  :test {:extra-paths ["test"]
         :jvm-opts ["--enable-native-access=ALL-UNNAMED"]
         :main-opts ["-m" "field-lab.test-runner"]}}}
