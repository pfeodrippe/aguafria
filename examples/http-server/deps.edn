{:paths ["src" "resources" "generated"]

 :deps {org.clojure/clojure {:mvn/version "1.12.0"}
        io.github.pfeodrippe/aguafria-macos-aarch64 {:mvn/version "0.1.7"}}

 :aliases
 {:dev
  {:jvm-opts ["--enable-native-access=ALL-UNNAMED"
              "-Daguafria.async-compile=true"
              "-Daguafria.optimize=fast"]}

  :prepare
  {:exec-fn aguafria.zig.package/prepare!
   :exec-args {:config "aguafria-packages.edn"
               :output "resources/aguafria/zig-packages.edn"}}

  :local-aguafria
  {:override-deps
   {io.github.pfeodrippe/aguafria-macos-aarch64 {:local/root "../.."}}}

  :nrepl
  {:extra-deps {nrepl/nrepl {:mvn/version "1.3.1"}}
   :jvm-opts ["--enable-native-access=ALL-UNNAMED"
              "-Daguafria.async-compile=true"
              "-Daguafria.optimize=fast"]
   :main-opts ["-m" "nrepl.cmdline"]}

  :test
  {:extra-paths ["test"]}

  :standalone
  {:jvm-opts ["--enable-native-access=ALL-UNNAMED"]
   :main-opts ["-m" "aguafria-http.build"]}}}
