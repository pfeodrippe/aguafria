{:paths ["src" "resources" "../src" "../resources" "../generated"]
 :deps {org.clojure/clojure {:mvn/version "1.12.0"}
        org.clojure/data.json {:mvn/version "2.5.2"}
        io.github.pfeodrippe/aguafria-macos-aarch64 {:local/root "../../.."}
        aguafria/examples-native {:local/root "../../shared" :exclusions [aguafria/aguafria]}}
 :aliases {:dev {:jvm-opts ["--enable-native-access=ALL-UNNAMED"]}
           :test {:extra-paths ["test"]
                  :main-opts ["-m" "la-professeure.bitwig-test"]}
           :repl {:extra-deps {nrepl/nrepl {:mvn/version "1.3.1"}}
                  :main-opts ["-m" "nrepl.cmdline"]}}}
