 {:clojure-source "(k/== (k/<<| (k/as 1 :u8) 8) 255)"
  :kind :expr
  :standalone? true
  :note "A saturating left shift clamps the u8 result to 255."}

 "a >> b\na >>= b"
 {:clojure-source "(k/>> a b)\n(k/>>= a b)"
  :kind :statements
  :alternatives? true
  :note "Right-shift expression and assignment alternatives."}

