 "a + b\na += b"
 {:clojure-source "(+ a b)\n(k/+= a b)"
  :kind :statements
  :alternatives? true
  :note "Addition expression and assignment alternatives; the assignment requires mutable a."}

 "2 + 5 == 7"
 {:clojure-source "(k/== (+ 2 5) 7)"
  :kind :expr
  :standalone? true
  :note "Addition is evaluated before equality."}

 "a +% b\na +%= b"
 {:clojure-source "(k/+% a b)\n(k/+%= a b)"
  :kind :statements
  :alternatives? true
  :note "Wrapping addition expression and assignment alternatives."}

