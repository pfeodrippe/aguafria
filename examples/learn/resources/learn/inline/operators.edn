 {:clojure-source "(k/== (k/!= 1 1) false)"
  :kind :expr
  :standalone? true
  :note "Equal integers do not satisfy inequality."}

 "a != null"
 {:clojure-source "(k/!= a nil)"
  :kind :expr
  :note "Check whether an optional has a non-null payload."}

 "const value: ?u32 = null;\n(value != null) == false"
 {:clojure-source "(let [value (k/as nil [:optional :u32])]\n  (k/== (k/!= value nil) false))"
  :kind :expr
  :standalone? true
  :note "A null optional fails the non-null check."}

 "a > b"
 {:clojure-source "(> a b)"
  :kind :expr
  :note "Strict greater-than comparison."}

