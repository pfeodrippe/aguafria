 {:clojure-source "(k/== (k/-% (k/as -128 :i8)) -128)"
  :kind :expr
  :standalone? true
  :note "Wrapping negation leaves the minimum i8 unchanged."}

 "a * b\na *= b"
 {:clojure-source "(* a b)\n(k/*= a b)"
  :kind :statements
  :alternatives? true
  :note "Multiplication expression and assignment alternatives."}

