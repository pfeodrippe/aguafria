 {:clojure-source "(k/== (k/+% (k/as 0xffffffff :u32) 1) 0)"
  :kind :expr
  :standalone? true
  :note "Adding one wraps the largest u32 to zero."}

 "a +| b\na +|= b"
 {:clojure-source "(k/+| a b)\n(k/+|= a b)"
  :kind :statements
  :alternatives? true
  :note "Saturating addition expression and assignment alternatives."}

