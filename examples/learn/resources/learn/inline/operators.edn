 {:clojure-source "(k/== (k/<< 2r1 8) 2r100000000)"
  :kind :expr
  :standalone? true
  :note "Clojure's 2r prefix writes binary integer literals."}

 "a <<| b\na <<|= b"
 {:clojure-source "(k/<<| a b)\n(k/<<|= a b)"
  :kind :statements
  :alternatives? true
  :note "Saturating left-shift expression and assignment alternatives."}

