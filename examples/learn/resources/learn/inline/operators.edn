 {:clojure-source "(k/== (k/*% (k/as 200 :u8) 2) 144)"
  :kind :expr
  :standalone? true
  :note "The product wraps modulo 256 for u8."}

 "a *| b\na *|= b"
 {:clojure-source "(k/*| a b)\n(k/*|= a b)"
  :kind :statements
  :alternatives? true
  :note "Saturating multiplication expression and assignment alternatives."}

