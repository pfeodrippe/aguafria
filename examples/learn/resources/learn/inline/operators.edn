 {:clojure-source "(k/== (- 2 5) -3)"
  :kind :expr
  :standalone? true
  :note "Comptime integer subtraction can produce a negative result."}

 "a -% b\na -%= b"
 {:clojure-source "(k/-% a b)\n(k/-%= a b)"
  :kind :statements
  :alternatives? true
  :note "Wrapping subtraction expression and assignment alternatives."}

 "@as(u8, 0) -% 1 == 255"
 {:clojure-source "(k/== (k/-% (k/as 0 :u8) 1) 255)"
  :kind :expr
  :standalone? true
  :note "Subtracting one wraps zero to the largest u8."}

 "a -| b\na -|= b"
 {:clojure-source "(k/-| a b)\n(k/-|= a b)"
  :kind :statements
  :alternatives? true
  :note "Saturating subtraction expression and assignment alternatives."}

 "@as(u32, 0) -| 1 == 0"
 {:clojure-source "(k/== (k/-| (k/as 0 :u32) 1) 0)"
  :kind :expr
  :standalone? true
  :note "Unsigned saturating subtraction stops at zero."}

 "-a"
 {:clojure-source "(- a)"
  :kind :expr
  :note "Unary negation can overflow a signed integer's minimum value."}

