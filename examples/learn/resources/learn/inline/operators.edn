 {:clojure-source "(k/== (* 2 5) 10)"
  :kind :expr
  :standalone? true
  :note "Multiply two comptime integers."}

 "a *% b\na *%= b"
 {:clojure-source "(k/*% a b)\n(k/*%= a b)"
  :kind :statements
  :alternatives? true
  :note "Wrapping multiplication expression and assignment alternatives."}

