 {:clojure-source "(k/== (k/>> 2r1010 1) 2r101)"
  :kind :expr
  :standalone? true
  :note "Shift the binary integer right by one bit."}

 "a & b\na &= b"
 {:clojure-source "(k/& a b)\n(k/&= a b)"
  :kind :statements
  :alternatives? true
  :note "Binary bitwise AND expression and assignment alternatives."}

 "0b011 & 0b101 == 0b001"
 {:clojure-source "(k/== (k/& 2r011 2r101) 2r001)"
  :kind :expr
  :standalone? true
  :note "Bitwise AND retains bits set in both operands."}

 "a | b\na |= b"
 {:clojure-source "(k/| a b)\n(k/|= a b)"
  :kind :statements
  :alternatives? true
  :note "Bitwise OR expression and assignment alternatives."}

 "0b010 | 0b100 == 0b110"
 {:clojure-source "(k/== (k/| 2r010 2r100) 2r110)"
  :kind :expr
  :standalone? true
  :note "Bitwise OR retains bits set in either operand."}

 "a ^ b\na ^= b"
 {:clojure-source "(k/bit-xor a b)\n(az/assign-expr \"^=\" a b)"
  :kind :statements
  :alternatives? true
  :note "XOR expression and assignment alternatives use reader-safe forms."}

 "0b011 ^ 0b101 == 0b110"
 {:clojure-source "(k/== (k/bit-xor 2r011 2r101) 2r110)"
  :kind :expr
  :standalone? true
  :note "XOR retains bits set in exactly one operand."}

 "~a"
 {:clojure-source "(k/bit-not a)"
  :kind :expr
  :note "Bitwise complement requires an integer with a known bit width."}

 "~@as(u8, 0b10101111) == 0b01010000"
 {:clojure-source "(k/== (k/bit-not (k/as 2r10101111 :u8)) 2r01010000)"
  :kind :expr
  :standalone? true
  :note "Complement all eight bits of the u8 value."}

 "a orelse b"
 {:clojure-source "(k/orelse a b)"
  :kind :expr
  :note "Evaluate b only when optional a is null."}

 "const value: ?u32 = null;\nconst unwrapped = value orelse 1234;\nunwrapped == 1234"
 {:clojure-source "(let [value (k/as nil [:optional :u32])\n      unwrapped (k/orelse value 1234)]\n  (k/== unwrapped 1234))"
  :kind :expr
  :standalone? true
  :note "A typed optional binding selects the fallback when null."}

 "a.?"
 {:clojure-source "(az/unwrap a)"
  :kind :expr
  :note "Unwrap an optional; null is illegal behavior."}

 "a orelse unreachable"
 {:clojure-source "(k/orelse a (k/unreachable))"
  :kind :expr
  :note "Explicitly assert that the optional is not null."}

 "const value: ?u32 = 5678;\nvalue.? == 5678"
 {:clojure-source "(let [value (k/as 5678 [:optional :u32])]\n  (k/== (az/unwrap value) 5678))"
  :kind :expr
  :standalone? true
  :note "Unwrap the non-null u32 payload."}

 "a catch b\na catch |err| b"
 {:clojure-source "(k/catch a b)\n(az/catch-capture [err] a b)"
  :kind :statements
  :alternatives? true
  :note "Alternative error handlers; the second makes err available to b."}

 "const value: anyerror!u32 = error.Broken;\nconst unwrapped = value catch 1234;\nunwrapped == 1234"
 {:clojure-source "(let [value (k/as (az/error-value :Broken) [:error-union :anyerror :u32])\n      unwrapped (k/catch value 1234)]\n  (k/== unwrapped 1234))"
  :kind :expr
  :standalone? true
  :note "Catch replaces the error with a successful fallback value."}

 "a and b"
 {:clojure-source "(and a b)"
  :kind :expr
  :note "Boolean AND evaluates b only when a is true."}

 "(false and true) == false"
 {:clojure-source "(k/== (and false true) false)"
  :kind :expr
  :standalone? true
  :note "A false left operand short-circuits boolean AND."}

 "a or b"
 {:clojure-source "(or a b)"
  :kind :expr
  :note "Boolean OR evaluates b only when a is false."}

 "(false or true) == true"
 {:clojure-source "(k/== (or false true) true)"
  :kind :expr
  :standalone? true
  :note "A false left operand causes boolean OR to evaluate the right operand."}

 "!a"
 {:clojure-source "(k/! a)"
  :kind :expr
  :note "Logical negation of a boolean."}

 "!false == true"
 {:clojure-source "(k/== (k/! false) true)"
  :kind :expr
  :standalone? true
  :note "Negating false produces true."}

 "a == b"
 {:clojure-source "(k/== a b)"
  :kind :expr
  :note "Equality compares peer-resolved operands."}

 "(1 == 1) == true"
 {:clojure-source "(k/== (k/== 1 1) true)"
  :kind :expr
  :standalone? true
  :note "Equal integer values produce true."}

 "a == null"
 {:clojure-source "(k/== a nil)"
  :kind :expr
  :note "Compare an optional with null, written nil in Aguafria."}

 "const value: ?u32 = null;\n(value == null) == true"
 {:clojure-source "(let [value (k/as nil [:optional :u32])]\n  (k/== (k/== value nil) true))"
  :kind :expr
  :standalone? true
  :note "A null optional compares equal to nil."}

 "a != b"
 {:clojure-source "(k/!= a b)"
  :kind :expr
  :note "Inequality compares peer-resolved operands."}

