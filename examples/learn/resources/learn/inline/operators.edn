  :standalone? true
  :note "The product saturates at the largest u8."}

 "a / b\na /= b"
 {:clojure-source "(/ a b)\n(k/div-assign a b)"
  :kind :statements
  :alternatives? true
  :note "Division expression and assignment alternatives; div-assign is reader-safe spelling."}

 "10 / 5 == 2"
 {:clojure-source "(k/== (/ 10 5) 2)"
  :kind :expr
  :standalone? true
  :note "Exact division of positive comptime integers."}

 "a % b\na %= b"
 {:clojure-source "(k/% a b)\n(k/%= a b)"
  :kind :statements
  :alternatives? true
  :note "Remainder expression and assignment alternatives."}

 "10 % 3 == 1"
 {:clojure-source "(k/== (k/% 10 3) 1)"
  :kind :expr
  :standalone? true
  :note "Positive integer division leaves a remainder of one."}

 "a << b\na <<= b"
 {:clojure-source "(k/<< a b)\n(k/<<= a b)"
  :kind :statements
  :alternatives? true
  :note "Left-shift expression and assignment alternatives."}

