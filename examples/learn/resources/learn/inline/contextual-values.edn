{"const number = parseU64(\"1234\", 10) catch unreachable;"
 {:clojure-source "(let [number (ak/catch (parseU64 \"1234\" 10) (ak/unreachable))]\n  number)"
  :kind :expr
  :note "Bind the successfully parsed number; an unexpected error reaches unreachable. The surrounding example supplies parseU64."}

 "catch unreachable"
 {:clojure-source ""
  :kind :syntax-note
  :note "An error-union expression can be unwrapped with (ak/catch value (ak/unreachable)). This asserts success rather than silently ignoring an error."}

 "||"
