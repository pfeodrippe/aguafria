 "const x: u32 = 1234;\nconst ptr = &x;\nptr.* == 1234"
 {:clojure-source "(let [x (ak/as 1234 :u32)\n      ptr (ak/& x)]\n  (ak/== @ptr 1234))"
  :kind :expr
  :standalone? true
  :note "Take the address of a typed local and read it through the pointer."}

 "&a"
