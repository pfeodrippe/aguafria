 {:clojure-source "(let [A (az/type [:error-set [:One]])\n      B (az/type [:error-set [:Two]])]\n  (ak/== (az/op \"||\" A B)\n      (az/type [:error-set [:One :Two]])))"
  :kind :expr
  :standalone? true
  :note "Merging error sets produces the set containing both error names."}

 "x() x[] x.y x.* x.?\na!b\nx{}\n!x -x -%x ~x &x ?x\n* / % ** *% *| ||\n+ - ++ +% -% +| -|\n<< >> <<|\n& ^ | orelse catch\n== != < > <= >=\nand\nor\n= *= *%= *|= /= %= += +%= +|= -= -%= -|= <<= <<|= >>= &= ^= |="
