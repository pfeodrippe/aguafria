 "a ++ b"
 {:clojure-source "(az/op \"++\" a b)"
  :kind :expr
  :note "Concatenate arrays whose lengths are known at compile time."}

 "const mem = @import(\"std\").mem;\nconst array1 = [_]u32{1,2};\nconst array2 = [_]u32{3,4};\nconst together = array1 ++ array2;\nmem.eql(u32, &together, &[_]u32{1,2,3,4})"
 {:clojure-source "(let [mem (az/field (ak/import \"std\") :mem)\n      array1 (az/array-init [1 2] [:array :_ :u32])\n      array2 (az/array-init [3 4] [:array :_ :u32])\n      together (az/op \"++\" array1 array2)]\n  ((az/field mem :eql) :u32\n    (ak/& together)\n    (ak/& (az/array-init [1 2 3 4] [:array :_ :u32]))))"
  :kind :expr
  :standalone? true
  :note "Import std.mem locally and compare the concatenated array element by element."}

 "a ** b"
 {:clojure-source "(az/op \"**\" a b)"
  :kind :expr
  :note "Repeat an array; its length and the repetition count must be comptime-known."}

 "const mem = @import(\"std\").mem;\nconst pattern = \"ab\" ** 3;\nmem.eql(u8, pattern, \"ababab\")"
 {:clojure-source "(let [mem (az/field (ak/import \"std\") :mem)\n      pattern (az/op \"**\" \"ab\" 3)]\n  ((az/field mem :eql) :u8 pattern \"ababab\"))"
  :kind :expr
  :standalone? true
  :note "Repeat the string three times and check its bytes with std.mem.eql."}

 "a.*"
