 {:zig-prefix
  "// Deterministic resource tokens model lifecycle calls, not a real allocator.
const Foo = struct { id: u32 };
const FixtureTmpBuffer = struct { id: u32 };
var fixture_fail_foo: bool = false;
var fixture_fail_tmp: bool = false;

fn tryToAllocateFoo() error{OutOfMemory}!Foo {
    @import(\"std\").debug.print(\"allocate-foo fail={}\\n\", .{fixture_fail_foo});
    if (fixture_fail_foo) return error.OutOfMemory;
    return .{ .id = 7 };
}
fn try_to_allocate_foo() error{OutOfMemory}!Foo {
    return tryToAllocateFoo();
}
fn deallocateFoo(foo: Foo) void {
    @import(\"std\").debug.print(\"free-foo id={d}\\n\", .{foo.id});
}
fn deallocate_foo(foo: Foo) void {
    deallocateFoo(foo);
}
fn allocateTmpBuffer() ?FixtureTmpBuffer {
    @import(\"std\").debug.print(\"allocate-tmp fail={}\\n\", .{fixture_fail_tmp});
    if (fixture_fail_tmp) return null;
    return .{ .id = 11 };
}
fn allocate_tmp_buffer() ?FixtureTmpBuffer {
    return allocateTmpBuffer();
}
fn deallocateTmpBuffer(buffer: FixtureTmpBuffer) void {
    @import(\"std\").debug.print(\"free-tmp id={d}\\n\", .{buffer.id});
}
fn deallocate_tmp_buffer(buffer: FixtureTmpBuffer) void {
    deallocateTmpBuffer(buffer);
}
"
  :entry "createFoo"
  :test-body
  "for ([_]bool{ false, true }) |fail_foo| {
    for ([_]bool{ false, true }) |fail_tmp| {
        for ([_]i32{ -1, 0, 1337, 1338, 2147483647 }) |param| {
            fixture_fail_foo = fail_foo;
            fixture_fail_tmp = fail_tmp;
            @import(\"std\").debug.print(\"scenario foo-fails={} tmp-fails={} param={d}\\n\", .{ fail_foo, fail_tmp, param });
            if (subject(param)) |foo| {
                @import(\"std\").debug.print(\"returned-foo id={d}\\n\", .{foo.id});
                // Success transfers ownership to this caller.
                @import(\"std\").debug.print(\"caller-cleanup\\n\", .{});
                deallocateFoo(foo);
            } else |err| {
                @import(\"std\").debug.print(\"returned-error {s}\\n\", .{@errorName(err)});
            }
        }
    }
}
"}

