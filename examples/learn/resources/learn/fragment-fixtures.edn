  "// The preceding parser spells OverFlow differently from these fragments.
// Adapt that spelling at the fixture boundary, retaining its parsing algorithm.
fn fixture_parse_u64(bytes: []const u8, radix: u8) error{OverFlow, InvalidChar}!u64 {
    var value: u64 = 0;
    for (bytes) |character| {
        const digit: u8 = switch (character) {
            '0'...'9' => character - '0',
            'A'...'Z' => character - 'A' + 10,
            'a'...'z' => character - 'a' + 10,
            else => 255,
        };
        if (digit >= radix) return error.InvalidChar;
        var result = @mulWithOverflow(value, radix);
        if (result[1] != 0) return error.OverFlow;
        result = @addWithOverflow(result[0], digit);
        if (result[1] != 0) return error.OverFlow;
        value = result[0];
    }
    return value;
}
fn parseU64(bytes: []const u8, radix: u8) error{Overflow, InvalidChar}!u64 {
    return fixture_parse_u64(bytes, radix) catch |err| switch (err) {
        error.OverFlow => error.Overflow,
        error.InvalidChar => error.InvalidChar,
    };
}
fn parse_u64(bytes: []const u8, radix: u8) error{Overflow, InvalidChar}!u64 {
    return parseU64(bytes, radix);
}
var fixture_number: ?u64 = null;
var fixture_number_calls: usize = 0;
fn doSomethingWithNumber(number: u64) void {
    fixture_number = number;
    fixture_number_calls += 1;
}
fn do_something_with_number(number: u64) void {
    doSomethingWithNumber(number);
}
