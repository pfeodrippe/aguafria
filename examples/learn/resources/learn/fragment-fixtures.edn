  :entry "cmpxchgWeakButNotAtomic"
  :test-body
  "const Scenario = struct { initial: i32, expected: i32, replacement: i32 };
const scenarios = [_]Scenario{
    .{ .initial = 7, .expected = 7, .replacement = 9 },
    .{ .initial = 7, .expected = 8, .replacement = 9 },
    .{ .initial = 0, .expected = 0, .replacement = 0 },
    .{ .initial = -3, .expected = -3, .replacement = 2 },
    .{ .initial = -3, .expected = 2, .replacement = -8 },
};
for ([_]bool{ true, false }) |allow_exchange| {
    for (scenarios) |scenario| {
        fixture_predicate = allow_exchange;
        fixture_predicate_calls = 0;
        var stored = scenario.initial;
        const previous = subject(i32, &stored, scenario.expected, scenario.replacement);
        @import(\"std\").debug.print(
            \"i32 allow={} initial={d} expected={d} replacement={d} previous={any} stored={d} predicate-calls={d}\\n\",
            .{ allow_exchange, scenario.initial, scenario.expected, scenario.replacement, previous, stored, fixture_predicate_calls },
        );
    }
}

// Exercise another supported value type, including short-circuit mismatches.
for ([_]bool{ true, false }) |allow_exchange| {
    for ([_]bool{ false, true }) |initial| {
        fixture_predicate = allow_exchange;
        fixture_predicate_calls = 0;
        var stored = initial;
        const previous = subject(bool, &stored, false, true);
        @import(\"std\").debug.print(
            \"bool allow={} initial={} previous={any} stored={} predicate-calls={d}\\n\",
            .{ allow_exchange, initial, previous, stored, fixture_predicate_calls },
        );
    }
}

// A failed attempt can be retried against the same still-current value.
var retry_value: i32 = 41;
fixture_predicate_calls = 0;
for ([_]bool{ false, true }) |allow_exchange| {
    fixture_predicate = allow_exchange;
    const previous = subject(i32, &retry_value, 41, 42);
    @import(\"std\").debug.print(
        \"retry allow={} previous={any} stored={d} predicate-calls={d}\\n\",
        .{ allow_exchange, previous, retry_value, fixture_predicate_calls },
    );
}
"}}
