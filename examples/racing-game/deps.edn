{:paths ["src" "resources"]

 :deps {org.clojure/clojure {:mvn/version "1.12.0"}
        aguafria/aguafria {:local/root "../.."}
        aguafria/examples-native {:local/root "../shared"}}

 :aliases
 {:nrepl
  {:extra-deps {nrepl/nrepl {:mvn/version "1.3.1"}}
   :jvm-opts ["--enable-native-access=ALL-UNNAMED"
              "-Daguafria.async-compile=true"
              "-Daguafria.optimize=ReleaseFast"]
   :main-opts ["-m" "nrepl.cmdline"]}

  :desktop
  {:extra-deps {nrepl/nrepl {:mvn/version "1.3.1"}}
   :jvm-opts ["--enable-native-access=ALL-UNNAMED"
              "-Daguafria.async-compile=true"
              "-Daguafria.optimize=ReleaseFast"
              "-XstartOnFirstThread"
              "-Xdock:name=Aguafria LLM Racing"]
   :main-opts ["-m" "racing-game.desktop-main"]}

  :standalone
  {:jvm-opts ["--enable-native-access=ALL-UNNAMED"]
   :main-opts ["-m" "racing-game.build" "standalone"]}

  :train-action-head
  {:jvm-opts ["--enable-native-access=ALL-UNNAMED"
              "-Daguafria.async-compile=true"
              "-Daguafria.optimize=ReleaseFast"]
   :main-opts ["-m" "racing-game.train-action-head"]}

  :test
  {:extra-paths ["test"]
   :extra-deps {lambdaisland/kaocha {:mvn/version "1.91.1392"}}
   :jvm-opts ["--enable-native-access=ALL-UNNAMED"
              "-Daguafria.async-compile=true"
              "-Daguafria.optimize=ReleaseFast"]
   :main-opts ["-m" "kaocha.runner"]}}}
