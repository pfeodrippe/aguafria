{:paths ["src" "resources"]

 :deps {org.clojure/clojure {:mvn/version "1.12.0"}
        aguafria/aguafria {:local/root "../.."}
        aguafria/examples-native {:local/root "../shared"}}

 :aliases
 {:jev-evaluation
  {:extra-deps {org.clojure/data.json {:mvn/version "2.5.2"}}}

  :dev
  {:jvm-opts ["--enable-native-access=ALL-UNNAMED"
              "-Daguafria.async-compile=true"
              "-Daguafria.optimize=fast"]}

  :nrepl
  {:extra-deps {nrepl/nrepl {:mvn/version "1.3.1"}}
   :jvm-opts ["--enable-native-access=ALL-UNNAMED"
              "-Daguafria.async-compile=true"
              "-Daguafria.optimize=fast"]
   :main-opts ["-m" "nrepl.cmdline"]}

  :desktop
  {:extra-deps {nrepl/nrepl {:mvn/version "1.3.1"}}
   :jvm-opts ["--enable-native-access=ALL-UNNAMED"
              "-Daguafria.async-compile=true"
              "-Daguafria.optimize=fast"
              "-XstartOnFirstThread"
              "-Xdock:name=Aguafria LLM Racing"]
   :main-opts ["-m" "racing-game.desktop-main"]}

  :standalone
  {:jvm-opts ["--enable-native-access=ALL-UNNAMED"]
   :main-opts ["-m" "racing-game.build" "standalone"]}

  :precompile
  {:jvm-opts ["--enable-native-access=ALL-UNNAMED"
              "-Daguafria.async-compile=true"
              "-Daguafria.optimize=fast"]
   :exec-fn aguafria.zig/precompile!
   :exec-args {:source-dirs ["src/racing_game"]
               :ignore [racing-game.shaders]
               :parallelism 2
               :report-file ".aguafria/precompile/racing-game.edn"}}

  :train-action-head
  {:jvm-opts ["--enable-native-access=ALL-UNNAMED"
              "-Daguafria.async-compile=true"
              "-Daguafria.optimize=fast"]
   :main-opts ["-m" "racing-game.train-action-head"]}

  :train-team-head
  {:jvm-opts ["--enable-native-access=ALL-UNNAMED"
              "-Daguafria.async-compile=true"
              "-Daguafria.optimize=fast"]
   :main-opts ["-m" "racing-game.train-team-head"]}

  :generate-replay-fixture
  {:jvm-opts ["--enable-native-access=ALL-UNNAMED"
              "-Daguafria.async-compile=true"
              "-Daguafria.optimize=fast"]
   :main-opts ["-m" "racing-game.replay-fixture"]}

  :generate-decision-corpus
  {:jvm-opts ["--enable-native-access=ALL-UNNAMED"
              "-Daguafria.async-compile=true"
              "-Daguafria.optimize=fast"]
   :main-opts ["-m" "racing-game.dataset"]}

  :test
  {:extra-paths ["test"]
   :extra-deps {lambdaisland/kaocha {:mvn/version "1.91.1392"}}
   :jvm-opts ["--enable-native-access=ALL-UNNAMED"
              "-Daguafria.async-compile=true"
              "-Daguafria.optimize=fast"]
   :main-opts ["-m" "kaocha.runner"]}}}
