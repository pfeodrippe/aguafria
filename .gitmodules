	branch = master
[submodule "examples/simple-game/vendor/glfw"]
	path = examples/simple-game/vendor/glfw
	url = https://github.com/glfw/glfw.git
	branch = master
[submodule "examples/simple-game/vendor/box3d"]
	path = examples/simple-game/vendor/box3d
