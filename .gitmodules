	branch = master
[submodule "examples/simple-game/vendor/vulkan-headers"]
	path = examples/simple-game/vendor/vulkan-headers
	url = https://github.com/KhronosGroup/Vulkan-Headers.git
	branch = main
[submodule "examples/simple-game/vendor/fonts/source-sans"]
